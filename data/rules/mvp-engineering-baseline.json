      "source_refs": ["docs/design/decisions/002-mvp-engineering-baseline.md#时间规则基线"], "limitations": ["均时差使用NOAA风格近似公式", "默认关闭"], "owner": "unassigned", "reviewers": [], "implementation": "app.calendar.timezone:apply_true_solar_time"
    },
