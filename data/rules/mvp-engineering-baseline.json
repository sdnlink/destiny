        {"rule_id": "CAL-SOLAR-TIME-001", "version": "1.0.0"},
        {"rule_id": "CAL-CONVERSION-001", "version": "1.0.0"},
        {"rule_id": "CAL-PILLARS-001", "version": "1.0.0"},
        {"rule_id": "YI-MANUAL-001", "version": "1.0.0"},
        {"rule_id": "YI-RELATION-001", "version": "1.0.0"},
        {"rule_id": "YI-NUMBER-001", "version": "1.0.0"},
        {"rule_id": "YI-NUMBER-002", "version": "1.0.0"},
        {"rule_id": "MH-TIME-001", "version": "1.0.0"},
        {"rule_id": "MH-NUMBER-001", "version": "1.0.0"},
        {"rule_id": "MH-BODYUSE-001", "version": "1.0.0"},
        {"rule_id": "MH-FIVE-ELEMENT-001", "version": "1.0.0"}
      ]
