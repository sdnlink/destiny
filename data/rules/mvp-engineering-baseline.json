    {
      "rule_id": "YI-AUTO-COIN-001", "version": "1.0.0", "system": "zhouyi", "school": "mvp-engineering-baseline", "status": "draft",
      "title": "个体三枚铜钱自动起卦", "purpose": "按独立起卦凭证可复算地派生六次三枚铜钱结果", "preconditions": ["起卦凭证格式有效"],
      "inputs": ["cast_nonce"], "procedure": ["按模块域和轮次计算SHA-256", "将每枚铜钱映射为2或3", "自下而上形成六爻"], "outputs": ["coin_rounds", "input_lines", "cast_nonce_hash"],
      "source_refs": ["docs/design/decisions/006-personalized-auto-casting.md"], "limitations": ["确定性工程实现待专家签署", "有限卦象空间允许自然撞卦"], "owner": "unassigned", "reviewers": [], "implementation": "app.core.iching:auto_cast"
    },
    {
      "rule_id": "MH-AUTO-PERSONAL-001", "version": "1.0.0", "system": "meihua", "school": "mvp-engineering-baseline", "status": "draft",
      "title": "梅花时间法个体加数", "purpose": "在传统年月日時取数中加入独立个体数", "preconditions": ["历法输入有效", "起卦凭证格式有效"],
      "inputs": ["calendar", "cast_nonce"], "procedure": ["由凭证派生1至64个体数", "年月日与个体数取上卦", "再加时数取下卦和动爻"], "outputs": ["personal_number", "original", "moving_line"],
      "source_refs": ["docs/design/decisions/006-personalized-auto-casting.md"], "limitations": ["个体加数属于工程基线待专家签署", "有限卦象空间允许自然撞卦"], "owner": "unassigned", "reviewers": [], "implementation": "app.core.meihua:auto_cast"
    },
