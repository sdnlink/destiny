      "inputs": ["cast_nonce", "calendar"], "procedure": ["使用六爻专属域派生六次三枚铜钱", "识别动爻", "排八宫纳甲等盘面"], "outputs": ["coin_rounds", "input_lines", "line_chart"],
      "source_refs": ["docs/design/decisions/006-personalized-auto-casting.md"], "limitations": ["确定性工程实现待专家签署", "有限卦象空间允许自然撞卦"], "owner": "unassigned", "reviewers": [], "implementation": "app.liuyao.engine:auto_cast"
    },
