      "inputs": ["local_datetime", "timezone"], "procedure": ["解析ISO-8601本地时间", "按IANA时区定位", "保留本地时间与UTC时间"], "outputs": ["original_local_datetime", "utc_datetime"],
      "source_refs": ["docs/design/decisions/002-mvp-engineering-baseline.md#时间规则基线"], "limitations": ["不接受输入自带UTC偏移"], "owner": "unassigned", "reviewers": [], "implementation": "app.calendar.timezone:parse_local_datetime"
    },
