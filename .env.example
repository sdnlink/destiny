# 复制为 .env 后按需修改；不要提交带真实口令的 .env
# ClickHouse（docker-compose.yml 里的默认口令仅为本地开发用）
CLICKHOUSE_URL=http://localhost:18123
CLICKHOUSE_USER=destiny
CLICKHOUSE_PASSWORD=change-me

# /v1 接口 Bearer 鉴权。留空表示不鉴权，只允许本地开发使用
APP_API_TOKEN=

# 会话 JSON 存储目录（默认 data/sessions）
# SESSION_STORAGE_DIR=

# 监听地址：绑定回环地址以外时必须设置 APP_API_TOKEN
APP_API_BIND=127.0.0.1
APP_API_PORT=8090

# 语料文献引用开关
ENABLE_LITERATURE=1
